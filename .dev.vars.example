# cp .dev.vars.example .dev.vars して値を入れる（.dev.vars は git 管理外）
# 任意: Google AI Studio (https://aistudio.google.com/apikey) で発行した無料の API キー
GEMINI_API_KEY=
# 任意: 使用量の画面に Cloudflare の無料枠の消費状況を出すときに設定する（docs/setup.md の手順 10）
# 「Account Analytics: Read」だけを持つ API トークンと、アカウント ID（npx wrangler whoami で確認できる）
CF_ANALYTICS_TOKEN=
CF_ACCOUNT_ID=
# ローカル開発で使うユーザーのメールアドレス。本番では Access の JWT から決めるので設定しない（docs/setup.md）
DEV_USER_EMAIL=owner@example.invalid
