{
  "permissions": {
    "allow": [
      "Bash(npm run check)",
      "Bash(npm run spell)",
      "Bash(npm run typecheck)",
      "Bash(npm run build)",
      "Bash(npm test)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(*gh *create*)",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check-gh-metadata.sh",
            "statusMessage": "issue・PR の情報付けを確認中"
          }
        ]
      }
    ]
  }
}
