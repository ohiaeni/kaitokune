{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kaitokune",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // <name>.<subdomain>.workers.dev で公開する（Cloudflare Access で本人だけに制限する前提）
  "workers_dev": true,
  // バージョンごとのプレビュー URL は Access の保護から漏れやすいので無効にしておく
  "preview_urls": false,
  "assets": {
    // SPA のルート（/entries など）は index.html を返し、/api/* だけ Worker で処理する
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // npm run dev:remote では開発中もリモート（自分のアカウントの無料枠）を使う。`npx wrangler login` が必要
  // （npm run dev はモック、npm run dev:local は Gemini だけで動き、Workers AI に接続しない。vite.config.ts）
  "ai": { "binding": "AI" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kaitokune",
      // `npx wrangler d1 create kaitokune` で作成した本番データベースの ID（秘密情報ではない）
      "database_id": "5c5dd610-bac0-4515-b2b1-a898515235d8",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // Workers AI のモデル。`npx wrangler ai models list` で一覧を確認できる
    "WORKERS_AI_MODEL": "@cf/google/gemma-4-26b-a4b-it",
    // Gemini のモデル（GEMINI_API_KEY を設定したときだけ使う予備）
    "GEMINI_MODEL": "gemini-flash-latest",
    // 無料枠を守るための、1 人 1 日あたりの AI 呼び出し上限（ユーザーごとに数える。合計がユーザー数 × この値になる）
    "AI_DAILY_LIMIT": "25",
    // 利用上限を数える「1 日」の区切りに使うタイムゾーン
    "TIMEZONE": "Asia/Tokyo"
  }
}
