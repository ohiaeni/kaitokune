{
  "editor.defaultFormatter": "biomejs.biome",
  "editor.formatOnSave": true,
  // ユーザー設定の言語ごとのフォーマッタ（Prettier など）より優先させるため、Biome が対応する言語ごとに指定する
  "[javascript]": { "editor.defaultFormatter": "biomejs.biome" },
  "[javascriptreact]": { "editor.defaultFormatter": "biomejs.biome" },
  "[typescript]": { "editor.defaultFormatter": "biomejs.biome" },
  "[typescriptreact]": { "editor.defaultFormatter": "biomejs.biome" },
  "[json]": { "editor.defaultFormatter": "biomejs.biome" },
  "[jsonc]": { "editor.defaultFormatter": "biomejs.biome" },
  "[css]": { "editor.defaultFormatter": "biomejs.biome" },
  "[tailwindcss]": { "editor.defaultFormatter": "biomejs.biome" },
  "[html]": { "editor.defaultFormatter": "biomejs.biome" },
  // Biome が対応していない Markdown・YAML は Prettier で整形する
  "[markdown]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[yaml]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "editor.codeActionsOnSave": {
    "source.fixAll.biome": "explicit",
    "source.organizeImports.biome": "explicit"
  },
  "files.associations": {
    "*.css": "tailwindcss"
  },
  "files.readonlyInclude": {
    "src/client/routeTree.gen.ts": true,
    "worker-configuration.d.ts": true
  },
  "files.exclude": {
    "**/.tanstack": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/.wrangler": true,
    "**/.tanstack": true,
    "src/client/routeTree.gen.ts": true,
    "worker-configuration.d.ts": true,
    "package-lock.json": true
  },
  "files.watcherExclude": {
    "**/.wrangler/**": true,
    "**/.tanstack/**": true,
    "**/dist/**": true
  }
}
