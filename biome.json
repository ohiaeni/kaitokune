{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": false,
    "includes": ["**", "!src/client/routeTree.gen.ts", "!worker-configuration.d.ts", "!migrations/meta"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "a11y": {
        "noLabelWithoutControl": {
          "level": "error",
          "options": {
            "inputComponents": ["TextInput", "TextArea"]
          }
        }
      },
      "nursery": {
        "noDrizzleDeleteWithoutWhere": {
          "level": "error",
          "options": {
            "drizzleObjectName": ["db"]
          }
        },
        "noDrizzleUpdateWithoutWhere": {
          "level": "error",
          "options": {
            "drizzleObjectName": ["db"]
          }
        },
        "noMisusedPromises": "error",
        "useExhaustiveSwitchCases": "error",
        "noFloatingPromises": "error"
      },
      "correctness": {
        "noUndeclaredDependencies": "error",
        "noNestedComponentDefinitions": "error",
        "noUnusedInstantiation": "error"
      },
      "suspicious": {
        "noConsole": {
          "level": "error",
          "options": {
            "allow": ["warn", "error"]
          }
        },
        "noImportCycles": "error",
        "noSkippedTests": "error",
        "noEmptyBlockStatements": "error",
        "noShadow": "error",
        "noEvolvingTypes": "error",
        "useErrorMessage": "error",
        "noUnusedExpressions": "error",
        "noBitwiseOperators": "error",
        "noNestedPromises": "error",
        "useArraySortCompare": "error",
        "noEqualsToNull": "error",
        "noForIn": "error"
      },
      "style": {
        "useThrowOnlyError": "error",
        "useThrowNewError": "error",
        "noUselessElse": "error",
        "useCollapsedElseIf": "error",
        "useCollapsedIf": "error",
        "useAtIndex": "error",
        "useConsistentArrayType": "error",
        "noInferrableTypes": "error",
        "noParameterAssign": "error",
        "useDefaultParameterLast": "error",
        "useForOf": "error",
        "noNegationElse": "error",
        "noEnum": "error",
        "useSelfClosingElements": "error",
        "useFragmentSyntax": "error",
        "noYodaExpression": "error",
        "useConsistentCurlyBraces": "error",
        "useShorthandAssign": "error",
        "useTrimStartEnd": "error",
        "noCommonJs": "error",
        "useNumberNamespace": "error",
        "noSubstr": "error",
        "useSingleVarDeclarator": "error",
        "useConsistentBuiltinInstantiation": "error",
        "noNestedTernary": "error",
        "useErrorCause": "error"
      },
      "complexity": {
        "noForEach": "error",
        "noUselessStringConcat": "error",
        "noUselessUndefined": "error",
        "noUselessCatchBinding": "error",
        "noUselessReturn": "error",
        "noImplicitCoercions": "error",
        "noVoid": "error",
        "useArrayFind": "error",
        "useWhile": "error"
      },
      "performance": {
        "noDelete": "error",
        "noNamespaceImport": "error"
      }
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "html": {
    "formatter": {
      "enabled": true
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
